{
  "version": 1,
  "discord": {
    "token": {
      "source": "env",
      "name": "DISCORD_BOT_TOKEN"
    }
  },
  "mcp": {
    "enabled": true,
    "guildId": "123456789012345678",
    "mode": "read_only",
    "toolsets": ["diagnostic"],
    "readOnly": true,
    "maxMessageBytes": 1048576,
    "maxConcurrentCalls": 4,
    "callTimeout": "30s"
  },
  "interactions": {
    "enabled": false,
    "listenAddress": "127.0.0.1:8443",
    "path": "/interactions",
    "maxBodyBytes": 65536,
    "maxConcurrentRequests": 32,
    "queueCapacity": 64,
    "workerCount": 4,
    "ackDeadline": "2500ms",
    "workTimeout": "2m",
    "callbackTimeout": "10s",
    "dedupTtl": "15m",
    "timestampSkew": "5m"
	},
	"automation": {
		"enabled": false,
		"workflowPaths": [],
		"sources": [],
		"cleanupChannels": [],
		"pollInterval": "30s",
		"leaseDuration": "2m",
		"workerCount": 2,
		"maxWorkflowBytes": 65536,
		"maxSteps": 100,
		"maxGuildsPerRun": 16,
		"maxActionsPerRun": 500,
		"maxDestructivePerRun": 25
	},
  "observability": {
    "exporter": "none"
  },
  "policy": {
    "mode": "apply",
    "actors": [
      {
        "id": "mcp-reader",
        "principals": [
          {
            "adapter": "mcp",
            "subject": "local-stdio",
            "authenticationMethod": "os-process"
          }
        ],
        "guilds": ["123456789012345678"],
        "capabilities": ["guild.inspect", "channel.read", "role.read"],
        "mode": "read_only"
      },
      {
        "id": "interaction-job-operator",
        "principals": [
          {
            "adapter": "interactions",
            "subject": "234567890123456789",
            "authenticationMethod": "discord-ed25519"
          }
        ],
        "guilds": ["123456789012345678"],
        "capabilities": ["job.read", "job.cancel", "job.resume"],
        "mode": "apply"
      }
    ]
  },
  "approvals": {
    "maxTtl": "15m"
  },
  "audit": {
    "path": "audit/events.jsonl",
    "retentionDays": 30,
    "maxBytes": 67108864
  },
  "securityAlerts": {
    "denialThreshold": 10,
    "denialWindow": "5m",
    "destructiveThreshold": 5,
    "destructiveWindow": "5m",
    "signatureFailureThreshold": 20,
    "signatureFailureWindow": "5m",
    "ackDeadlineMissThreshold": 3,
    "ackDeadlineMissWindow": "5m",
    "callbackFailureThreshold": 5,
    "callbackFailureWindow": "5m",
    "handlerSaturationThreshold": 5,
    "handlerSaturationWindow": "5m"
  }
}

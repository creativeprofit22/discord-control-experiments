{
  "version": 1,
  "discord": {
    "token": {
      "source": "env",
      "name": "DISCORD_BOT_TOKEN"
    }
  },
  "mcp": {
    "enabled": true,
    "guildId": "123456789012345678",
    "mode": "read_only",
    "toolsets": ["diagnostic"],
    "readOnly": true,
    "maxMessageBytes": 1048576,
    "maxConcurrentCalls": 4,
    "callTimeout": "30s"
  },
  "observability": {
    "exporter": "none"
  },
  "policy": {
    "mode": "read_only",
    "actors": [
      {
        "id": "mcp-reader",
        "principals": [
          {
            "adapter": "mcp",
            "subject": "local-stdio",
            "authenticationMethod": "os-process"
          }
        ],
        "guilds": ["123456789012345678"],
        "capabilities": ["guild.inspect", "channel.read", "role.read"],
        "mode": "read_only"
      }
    ]
  },
  "approvals": {
    "maxTtl": "15m"
  },
  "audit": {
    "path": "audit/events.jsonl",
    "retentionDays": 30,
    "maxBytes": 67108864
  },
  "securityAlerts": {
    "denialThreshold": 10,
    "denialWindow": "5m",
    "destructiveThreshold": 5,
    "destructiveWindow": "5m"
  }
}

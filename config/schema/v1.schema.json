{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/discord-control/config/v1.schema.json",
  "title": "Discord Control configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "discord", "mcp", "observability"],
  "$defs": {
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name"],
      "properties": { "source": { "const": "env" }, "name": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "mode": { "enum": ["read_only", "dry_run", "apply"] },
    "principal": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "subject", "authenticationMethod"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1, "maxLength": 64 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "authenticationMethod": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "discord": {
      "type": "object", "additionalProperties": false, "required": ["token"],
      "properties": {
        "token": { "$ref": "#/$defs/secretReference" },
        "webhooks": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "type": "object", "additionalProperties": false, "required": ["name", "url"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 64 }, "url": { "$ref": "#/$defs/secretReference" } } }
        }
      }
    },
    "mcp": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "guildId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "mode": { "$ref": "#/$defs/mode" },
        "toolsets": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["build", "moderation", "news", "diagnostic"] } },
        "readOnly": { "type": "boolean" },
        "maxMessageBytes": { "type": "integer", "minimum": 4096, "maximum": 8388608 },
        "maxConcurrentCalls": { "type": "integer", "minimum": 1, "maximum": 32 },
        "callTimeout": { "type": "string", "minLength": 2, "maxLength": 16 }
      }
    },
    "interactions": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "listenAddress": { "type": "string", "minLength": 3, "maxLength": 255 },
        "path": { "const": "/interactions" },
        "applicationId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "signingPublicKeys": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "registration": { "type": "object", "additionalProperties": false, "properties": { "scope": { "enum": ["guild", "global"] }, "guildId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" } } },
        "tls": { "type": "object", "additionalProperties": false, "properties": { "mode": { "enum": ["direct", "trusted_proxy"] }, "certificate": { "$ref": "#/$defs/secretReference" }, "privateKey": { "$ref": "#/$defs/secretReference" }, "trustedProxyCidrs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 64 } } } },
        "maxBodyBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "maxConcurrentRequests": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "queueCapacity": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "workerCount": { "type": "integer", "minimum": 1, "maximum": 128 },
        "ackDeadline": { "type": "string", "minLength": 2, "maxLength": 16 },
        "workTimeout": { "type": "string", "minLength": 2, "maxLength": 16 },
        "callbackTimeout": { "type": "string", "minLength": 2, "maxLength": 16 },
        "dedupTtl": { "type": "string", "minLength": 2, "maxLength": 16 },
        "timestampSkew": { "type": "string", "minLength": 2, "maxLength": 16 }
      }
    },
    "observability": {
      "type": "object", "additionalProperties": false, "required": ["exporter"],
      "properties": { "exporter": { "enum": ["none", "stderr", "otlp-http"] }, "endpoint": { "type": "string", "minLength": 1 } }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["mode", "actors"],
      "properties": {
        "mode": { "$ref": "#/$defs/mode" },
        "actors": { "type": "array", "maxItems": 64, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "principals", "guilds", "capabilities", "mode"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "principals": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/principal" } },
            "guilds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" } },
            "capabilities": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "enum": ["guild.inspect", "channel.read", "channel.manage", "role.read", "role.manage", "member.read", "member.moderate", "message.read", "message.manage", "webhook.read", "webhook.manage", "invite.read", "invite.manage", "application_command.read", "application_command.manage", "onboarding.read", "onboarding.manage", "scheduled_event.read", "scheduled_event.manage", "auto_moderation.read", "auto_moderation.manage", "job.read", "job.cancel", "job.resume", "moderation.case.read", "moderation.case.write", "moderation.evidence.write", "moderation.evidence.export", "moderation.warn", "moderation.timeout", "moderation.kick", "moderation.ban", "moderation.message_delete", "moderation.quarantine", "moderation.invite_control", "moderation.escalation.evaluate", "moderation.lockdown.plan", "moderation.lockdown.apply", "moderation.lockdown.recover"] } },
            "mode": { "$ref": "#/$defs/mode" },
            "preapprovedOperations": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^*]+$" } }
          }
        } }
      }
    },
    "approvals": { "type": "object", "additionalProperties": false, "required": ["maxTtl"], "properties": { "maxTtl": { "type": "string", "minLength": 2, "maxLength": 16 } } },
    "audit": { "type": "object", "additionalProperties": false, "required": ["path", "retentionDays", "maxBytes"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 512 }, "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }, "maxBytes": { "type": "integer", "minimum": 65536, "maximum": 10737418240 } } },
    "securityAlerts": { "type": "object", "additionalProperties": false, "required": ["denialThreshold", "denialWindow", "destructiveThreshold", "destructiveWindow"], "properties": { "denialThreshold": { "type": "integer", "minimum": 1, "maximum": 10000 }, "denialWindow": { "type": "string", "minLength": 2, "maxLength": 16 }, "destructiveThreshold": { "type": "integer", "minimum": 1, "maximum": 10000 }, "destructiveWindow": { "type": "string", "minLength": 2, "maxLength": 16 }, "signatureFailureThreshold": { "type": "integer", "minimum": 1, "maximum": 10000 }, "signatureFailureWindow": { "type": "string", "minLength": 2, "maxLength": 16 }, "ackDeadlineMissThreshold": { "type": "integer", "minimum": 1, "maximum": 10000 }, "ackDeadlineMissWindow": { "type": "string", "minLength": 2, "maxLength": 16 }, "callbackFailureThreshold": { "type": "integer", "minimum": 1, "maximum": 10000 }, "callbackFailureWindow": { "type": "string", "minLength": 2, "maxLength": 16 }, "handlerSaturationThreshold": { "type": "integer", "minimum": 1, "maximum": 10000 }, "handlerSaturationWindow": { "type": "string", "minLength": 2, "maxLength": 16 }, "moderationDestructiveThreshold": { "type": "integer", "minimum": 1, "maximum": 10000 }, "moderationDestructiveWindow": { "type": "string", "minLength": 2, "maxLength": 16 }, "lockdownPartialFailureThreshold": { "type": "integer", "minimum": 1, "maximum": 10000 }, "lockdownPartialFailureWindow": { "type": "string", "minLength": 2, "maxLength": 16 } } },
    "reconciliation": { "type": "object", "additionalProperties": false, "required": ["stateDirectory", "maxOperations", "maxDestructiveOperations", "retentionDays"], "properties": { "stateDirectory": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?![\\/]|.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+$" }, "maxOperations": { "type": "integer", "minimum": 1, "maximum": 10000 }, "maxDestructiveOperations": { "type": "integer", "minimum": 0, "maximum": 10000 }, "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 } } },
    "moderation": { "type": "object", "additionalProperties": false, "required": ["policyVersion", "retention", "maxCasesPerGuild", "maxActionsPerCase", "maxActionsPerSubjectWindow", "maxActionsPerGuildWindow", "reasonCodes", "protectedOperatorRoleIds", "escalationRules", "maxLockdownOperations", "maxLockdownDestructiveOperations", "lockdownPlanTtl"], "properties": { "policyVersion": { "type": "string", "minLength": 1, "maxLength": 64 }, "retention": { "type": "string", "minLength": 2, "maxLength": 16 }, "maxCasesPerGuild": { "type": "integer", "minimum": 1, "maximum": 100000 }, "maxActionsPerCase": { "type": "integer", "minimum": 1, "maximum": 1000 }, "maxActionsPerSubjectWindow": { "type": "integer", "minimum": 1, "maximum": 1000 }, "maxActionsPerGuildWindow": { "type": "integer", "minimum": 1, "maximum": 10000 }, "reasonCodes": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }, "quarantineRoleId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }, "protectedOperatorRoleIds": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" } }, "escalationRules": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["id", "priority", "eligiblePriorKinds", "lookback", "minimumCount", "action", "maximumApplications"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 64 }, "priority": { "type": "integer", "minimum": 0, "maximum": 10000 }, "eligiblePriorKinds": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string" } }, "lookback": { "type": "string" }, "minimumCount": { "type": "integer", "minimum": 1 }, "action": { "type": "string" }, "duration": { "type": "string" }, "deleteWindow": { "type": "string" }, "maximumApplications": { "type": "integer", "minimum": 1 } } } }, "maxLockdownOperations": { "type": "integer", "minimum": 1, "maximum": 1000 }, "maxLockdownDestructiveOperations": { "type": "integer", "minimum": 1, "maximum": 1000 }, "lockdownPlanTtl": { "type": "string", "minLength": 2, "maxLength": 16 } } },
    "secretEnvironmentAllowlist": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$" } }
  }
}
